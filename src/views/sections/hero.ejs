<%# hero.ejs | first screen with a rotating background.
    Styles: public/css/hero.css. Slideshow script: public/js/hero-slider.js.
    Photos, focus point and timing: src/data/site.js (assets.heroSlides, assets.heroSlideInterval).
    Only the FIRST photo loads with the page; hero-slider.js loads the others afterwards
    so the first screen appears faster on slow phone connections. %>
<section id="hero" class="hero-section">
  <div class="hero-bg" data-hero-slider data-interval="<%= site.assets.heroSlideInterval %>">
    <% site.assets.heroSlides.forEach(function (slide, index) { %>
    <% if (index === 0) { %>
    <img src="<%= slide.src %>" alt="" aria-hidden="true" class="hero-bg-img is-active" fetchpriority="high"<% if (slide.focus) { %> style="--focus: <%= slide.focus %>"<% } %>>
    <% } else { %>
    <img data-src="<%= slide.src %>" alt="" aria-hidden="true" class="hero-bg-img" decoding="async"<% if (slide.focus) { %> style="--focus: <%= slide.focus %>"<% } %>>
    <% } %>
    <% }); %>
    <div class="hero-overlay"></div>
  </div>

  <div class="container hero-content">
    <div class="hero-badge">✦ <%= site.hero.badge %></div>

    <img src="<%= site.assets.logo %>" alt="<%= site.name %>" class="hero-logo" width="<%= site.assets.logoSize.width %>" height="<%= site.assets.logoSize.height %>">

    <p class="hero-subheadline"><%= site.hero.subheadline %></p>

    <div class="hero-buttons">
      <a href="<%= site.hero.primaryButton.href %>" class="btn-primary"><%= site.hero.primaryButton.label %></a>
      <a href="<%= site.hero.secondaryButton.href %>" class="btn-secondary"><%= site.hero.secondaryButton.label %></a>
    </div>
  </div>

  <!-- Hero Background Slider Script -->
  <script>
    (function () {
      'use strict';
      var hero = document.querySelector('[data-hero-slider]');
      if (!hero) return;

      var slides = hero.querySelectorAll('.hero-bg-img');
      if (slides.length < 2) return;

      var prefersReducedMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      if (prefersReducedMotion) return;

      var interval = parseInt(hero.getAttribute('data-interval'), 10) || 6000;
      var current = 0;
      var timer = null;

      // Swap data-src to real src so the browser downloads waiting slides
      function loadWaitingSlides() {
        for (var i = 0; i < slides.length; i++) {
          var address = slides[i].getAttribute('data-src');
          if (address) {
            slides[i].src = address;
            slides[i].removeAttribute('data-src');
          }
        }
      }

      function show(index) {
        slides[current].classList.remove('is-active');
        current = index;
        slides[current].classList.add('is-active');
      }

      function next() {
        var target = (current + 1) % slides.length;
        if (!slides[target].complete || !slides[target].naturalWidth) return;
        show(target);
      }

      function start() {
        if (!timer) timer = setInterval(next, interval);
      }

      function stop() {
        clearInterval(timer);
        timer = null;
      }

      function begin() {
        loadWaitingSlides();
        start();
      }

      document.addEventListener('visibilitychange', function () {
        if (document.hidden) stop();
        else start();
      });

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', begin);
      } else {
        begin();
      }
    })();
  </script>
</section>
